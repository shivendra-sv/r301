{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // scripts/** is checked by tsconfig.scripts.json, which is the only place
  // Node types are visible. Script modules imported by tests are still checked
  // here, through those imports, and so must stay Node-free.
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
